<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>中美政策雷达</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=Noto+Serif+SC:wght@400;500;700;900&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F4F0E7; --paper:#FCFAF4; --ink:#1B1814; --sub:#6A6155;
    --line:#E5DECF; --line2:#D8CFBC;
    --red:#BE2E16; --red-bg:#FBEDE9;
    --amber:#8F6510; --amber-bg:#F8F0DE;
    --gray:#9C9384; --green:#2F6B43;
    --serif:"Noto Serif SC",serif; --display:"Fraunces",Georgia,serif; --sans:"Noto Sans SC",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);color:var(--ink);font-family:var(--serif);
    line-height:1.6;-webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%;
    background-image:radial-gradient(circle at 1px 1px, rgba(0,0,0,.018) 1px, transparent 0);
    background-size:5px 5px;
  }
  .wrap{max-width:820px;margin:0 auto;padding:0 22px 80px}
  a{color:inherit}

  /* Masthead */
  .top-rule{height:5px;background:linear-gradient(90deg,var(--red) 0 22%,var(--ink) 22% 100%)}
  header{padding:30px 0 16px}
  .kicker{font-family:var(--sans);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:8px}
  h1.title{font-family:var(--display);font-weight:900;font-size:clamp(32px,6vw,50px);line-height:1.02;letter-spacing:-.01em}
  h1.title .cn{font-family:var(--serif);font-weight:900;display:block;font-size:.62em;margin-top:6px;letter-spacing:.02em}
  .dateline{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin-top:14px;font-family:var(--sans);font-size:12.5px;color:var(--sub)}
  .dateline .dot{width:4px;height:4px;border-radius:50%;background:var(--line2)}
  .counts{display:flex;gap:14px;font-family:var(--sans);font-weight:700;font-size:12.5px}
  .counts b{font-size:15px}
  .c-high{color:var(--red)} .c-med{color:var(--amber)} .c-low{color:var(--gray)}

  /* 顶部 sticky 锚点导航 */
  .anchornav{position:sticky;top:0;z-index:20;background:var(--bg);border-top:1px solid var(--line);border-bottom:2px solid var(--ink);
    display:flex;gap:4px;overflow-x:auto;white-space:nowrap;padding:8px 0;-webkit-overflow-scrolling:touch}
  .anchornav::-webkit-scrollbar{display:none}
  .anchornav a{font-family:var(--sans);font-size:12.5px;font-weight:700;color:var(--sub);text-decoration:none;
    padding:5px 12px;border-radius:100px;flex:0 0 auto}
  .anchornav a:hover{color:var(--ink);background:var(--paper)}
  section[id]{scroll-margin-top:52px}

  /* 今日主线 */
  .thread{background:var(--paper);border:1px solid var(--line2);border-left:4px solid var(--ink);
    border-radius:3px;padding:16px 20px;margin:18px 0 6px}
  .thread .th-lbl{font-family:var(--sans);font-size:10.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--red);margin-bottom:7px}
  .thread p{font-size:15.5px;line-height:1.66;color:#2C2820}
  .th-jump{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-top:12px;padding-top:11px;border-top:1px solid var(--line)}
  .th-jump .tj-lbl{font-family:var(--sans);font-size:11px;color:var(--sub)}
  .th-jump .tj{font-family:var(--sans);font-size:11.5px;text-decoration:none;background:#fff;border:1px solid var(--line2);
    color:var(--ink);padding:3px 10px;border-radius:100px}
  .th-jump .tj:hover{border-color:var(--red);color:var(--red)}

  /* 📅 未来看点：紧凑日历清单 */
  .watch{margin:16px 0 4px}
  .watchlist{list-style:none}
  .watch-row{display:flex;gap:11px;align-items:baseline;padding:8px 2px;border-bottom:1px dotted var(--line)}
  .wdate{font-family:var(--sans);font-size:12px;font-weight:700;color:var(--red);white-space:nowrap;min-width:96px;flex:0 0 auto;font-variant-numeric:tabular-nums}
  .wtitle{flex:1;font-size:14px;color:var(--ink);text-decoration:none;line-height:1.4}
  a.wtitle:hover{text-decoration:underline}
  .wtags{font-family:var(--sans);font-size:10.5px;color:var(--gray);white-space:nowrap}

  /* 主题标签筛选（非 sticky） */
  .filters{padding:14px 0 6px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .filters .lbl{font-family:var(--sans);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--sub);margin-right:4px}
  .chip{font-family:var(--sans);font-size:12.5px;font-weight:500;padding:5px 13px;border:1px solid var(--line2);
    border-radius:100px;background:var(--paper);cursor:pointer;color:var(--ink);transition:all .15s;white-space:nowrap}
  .chip:hover{border-color:var(--ink)} .chip.active{background:var(--ink);color:#fff;border-color:var(--ink)}

  /* Section heads */
  .section-head{display:flex;align-items:baseline;gap:12px;margin:30px 0 14px}
  .section-head .bar{font-family:var(--display);font-weight:900;font-size:20px}
  .section-head .en{font-family:var(--sans);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--sub)}
  .section-head .line{flex:1;height:1px;background:var(--line)}
  .newline{font-family:var(--sans);font-size:11.5px;font-weight:700;letter-spacing:.04em;color:var(--red);
    display:flex;align-items:center;gap:10px;margin:0 0 14px}
  .newline::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--red-bg),transparent)}

  /* 来源/状态小标签 */
  .stype{font-family:var(--sans);font-size:10.5px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:4px}
  .st-gov{background:#ECEAF4;color:#4A3F86} .st-media{background:#F0EEE8;color:#7A7263}
  .st-view{background:#EFEDE6;color:#6A6155} .st-person{background:#EAF0EC;color:#2F6B43}
  .rumor{font-family:var(--sans);font-size:10.5px;font-weight:700;color:#fff;background:#B0741A;padding:2px 8px;border-radius:4px}
  .fresh{font-family:var(--sans);font-size:10px;font-weight:700;color:var(--green);background:#E5F0E8;border:1px solid #BCD9C6;padding:2px 7px;border-radius:100px}

  /* ②③ 信号卡片（high/medium 统一）*/
  .sig{background:var(--paper);border:1px solid var(--line2);border-radius:3px;padding:18px 22px;margin-bottom:13px;box-shadow:0 1px 0 rgba(0,0,0,.02)}
  .sig.high{border-left:4px solid var(--red)}
  .sig.medium{border-left:4px solid var(--amber)}
  .sig .meta-top{display:flex;align-items:center;gap:9px;margin-bottom:10px;flex-wrap:wrap}
  .sig-lab{font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.1em;padding:2px 10px;border-radius:4px}
  .sig-lab.high{background:var(--red);color:#fff}
  .sig-lab.medium{background:var(--amber-bg);color:var(--amber);border:1px solid #E3C98F}
  .sig-h{font-family:var(--serif);font-weight:700;line-height:1.3;margin-bottom:9px;letter-spacing:-.005em}
  .sig.high .sig-h{font-size:clamp(19px,2.6vw,23px)}
  .sig.medium .sig-h{font-size:17px}
  .sig-h a{text-decoration:none}.sig-h a:hover{text-decoration:underline}
  .synopsis{font-size:14.5px;color:#3A352E;margin-bottom:11px;line-height:1.6}
  .impact{border-left:3px solid var(--red);background:var(--red-bg);padding:8px 13px;border-radius:0 3px 3px 0;font-size:13.5px;color:#5A2418;margin-bottom:11px;line-height:1.55}
  .sig.medium .impact{border-left-color:var(--amber);background:var(--amber-bg);color:#5C4310}
  .impact b{font-family:var(--sans);font-weight:700;font-size:11px;letter-spacing:.1em;color:var(--red);margin-right:7px}
  .sig.medium .impact b{color:var(--amber)}
  .byline,.who{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-bottom:9px}
  .byline .lbl,.who .who-lbl{font-family:var(--sans);font-size:11px;color:var(--sub);min-width:52px}
  .person{font-family:var(--sans);font-size:12px;font-weight:500;background:#fff;border:1px solid var(--line2);padding:3px 10px;border-radius:100px}
  .person.au{background:var(--ink);color:#fff;border-color:var(--ink)}
  .card-foot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding-top:11px;border-top:1px solid var(--line)}
  .src{font-family:var(--sans);font-size:11.5px;color:var(--sub)} .src a{color:var(--red);text-decoration:none;font-weight:500} .src a:hover{text-decoration:underline}
  .tags{display:flex;gap:6px;flex-wrap:wrap}
  .tag{font-family:var(--sans);font-size:11px;color:var(--ink);background:var(--red-bg);padding:2px 9px;border-radius:100px;cursor:pointer}
  .sig.medium .tag{background:var(--amber-bg)}
  .empty-note{font-size:14px;color:var(--gray);padding:18px;text-align:center;border:1px dashed var(--line2);border-radius:3px;background:var(--paper)}
  /* 关键日期角标（右上 pill，仅 high）*/
  .kdate{margin-left:auto;font-family:var(--sans);font-size:11px;font-weight:700;color:#fff;background:var(--ink);padding:2px 9px;border-radius:100px;white-space:nowrap}
  .sig.high .kdate{background:var(--red)}
  .kdate.old{background:#CFC7B5!important;color:#5A5448}   /* 较早事件：灰色淡化 */
  /* 研判行（仅 high）：图标前缀 + 轻底色高亮，比 summary 突出比标题轻 */
  .soval{display:flex;gap:8px;align-items:baseline;background:#F1ECE0;border:1px solid #E5DBC6;border-radius:4px;
    padding:9px 12px;margin-bottom:11px;font-size:13.5px;color:#3A352E;line-height:1.55}
  .soval-lbl{font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--amber);white-space:nowrap;flex:0 0 auto}
  /* 折叠块（③ 值得关注 / ④ 人物中低组）*/
  .foldblock > summary, details.pgroup > summary{font-family:var(--sans);font-weight:700;font-size:13px;cursor:pointer;color:var(--sub);list-style:none;
    padding:11px 14px;background:var(--paper);border:1px dashed var(--line2);border-radius:3px;margin-bottom:0}
  .foldblock > summary::-webkit-details-marker,details.pgroup > summary::-webkit-details-marker{display:none}
  .foldblock[open] > summary,details.pgroup[open] > summary{margin-bottom:12px}
  .pgroup-lbl{font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin:2px 0 10px}
  details.pgroup{margin:10px 0}

  /* ④ 人在说什么：折叠 + 子筛选 + 瘦身卡片 */
  details.peoplebox > summary{font-family:var(--sans);font-weight:700;font-size:13px;cursor:pointer;color:var(--sub);list-style:none;
    padding:11px 14px;background:var(--paper);border:1px dashed var(--line2);border-radius:3px}
  details.peoplebox > summary::-webkit-details-marker{display:none}
  details.peoplebox > summary::before{content:"▸ ";color:var(--gray)} details.peoplebox[open] > summary::before{content:"▾ "}
  details.peoplebox[open] > summary{margin-bottom:12px}
  .psub{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 12px}
  .psub-btn{font-family:var(--sans);font-size:12px;padding:4px 12px;border:1px solid var(--line2);border-radius:100px;background:var(--paper);cursor:pointer;color:var(--sub);transition:.15s}
  .psub-btn:hover{border-color:var(--ink)} .psub-btn.active{background:var(--ink);color:#fff;border-color:var(--ink)}
  .pcard{padding:9px 2px;border-bottom:1px dotted var(--line)}
  .pcard.hide{display:none!important}
  .prow1{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-bottom:3px}
  .pauthor{font-family:var(--sans);font-size:13px;font-weight:700;color:var(--ink)}
  .ptitle{font-family:var(--sans);font-size:11px;color:var(--sub)}
  .ptag{font-family:var(--sans);font-size:10px;font-weight:700;padding:1px 6px;border-radius:3px;margin-left:auto}
  .pt-reporter{background:#E7EEF6;color:#2C5A86} .pt-scholar{background:#EAF0EC;color:#2F6B43} .pt-vcind{background:#F3ECE2;color:#8A5A2B}
  .pone{display:block;font-family:var(--serif);font-size:14.5px;font-weight:500;color:var(--ink);text-decoration:none;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
  .pone:hover{text-decoration:underline}
  .prow3{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-family:var(--sans);font-size:11px;color:var(--gray)}
  .prow3 .ptime{font-variant-numeric:tabular-nums}
  .prow3 .tag{font-size:10.5px;color:var(--ink);background:#EFEEE8;padding:1px 7px;border-radius:100px}
  .plab{font-family:var(--sans);font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:3px;margin-left:auto}
  .plab.high{background:var(--red);color:#fff} .plab.medium{background:var(--amber-bg);color:var(--amber)} .plab.low{background:#EEEAE0;color:var(--gray)}

  /* ⑤ 低信号折叠 */
  details.low{margin-top:6px}
  details.low summary{font-family:var(--sans);font-weight:700;font-size:13px;cursor:pointer;color:var(--sub);list-style:none;padding:11px 14px;background:var(--paper);border:1px dashed var(--line2);border-radius:3px}
  details.low summary::-webkit-details-marker{display:none}
  details.low summary::before{content:"▸ ";color:var(--gray)} details.low[open] summary::before{content:"▾ "}
  details.low[open] summary{margin-bottom:11px}
  .low-item{display:flex;gap:10px;align-items:baseline;padding:10px 2px;border-bottom:1px dotted var(--line);font-size:14px;color:var(--sub)}
  .low-item.hide{display:none!important}
  .low-item .src{flex-shrink:0;font-weight:500;color:var(--ink)} .low-item .lt{flex:1} .low-item .lt a{color:inherit;text-decoration:none} .low-item .lt a:hover{text-decoration:underline}
  .low-item .ltag{font-family:var(--sans);font-size:10.5px;color:var(--gray);white-space:nowrap}

  .hide{display:none!important}
  footer{margin-top:34px;font-family:var(--sans);font-size:11.5px;color:var(--gray);line-height:1.7;border-top:1px solid var(--line);padding-top:16px}
</style>
</head>
<body>
<div class="top-rule"></div>
<div class="wrap">

  <header>
    <div class="kicker">独立信号雷达 · 不是新闻聚合</div>
    <h1 class="title">US-CHINA RADAR<span class="cn">中美政策雷达</span></h1>
    <div class="dateline">
      <span>最后更新 {{ generated_full }}</span><span class="dot"></span>
      <div class="counts">
        <span class="c-high"><b>{{ high|length }}</b> 高</span>
        <span class="c-med"><b>{{ medium|length }}</b> 中</span>
        <span class="c-low"><b>{{ low|length }}</b> 低</span>
      </div>
    </div>
  </header>

  <!-- ① 顶部 sticky 锚点导航 -->
  <nav class="anchornav" id="nav">
    <a href="#thread">今日主线</a>
    {% if watch %}<a href="#watch">📅 未来看点</a>{% endif %}
    <a href="#high">🔴 高信号</a>
    <a href="#medium" data-open="medium">🟡 值得关注</a>
    <a href="#people" data-open="people">🗣 人在说什么</a>
    <a href="#low" data-open="low">⚪ 低信号</a>
  </nav>

  {% if daily_thread %}
  <section id="thread" class="thread">
    <div class="th-lbl">今日主线 · The Thread</div>
    <p>{{ daily_thread }}</p>
    {% if thread_anchors %}
    <div class="th-jump"><span class="tj-lbl">📍 跳转</span>
      {% for a in thread_anchors %}<a class="tj" href="#{{ a.aid }}">{{ a.label }}</a>{% endfor %}
    </div>{% endif %}
  </section>
  {% endif %}

  {% if watch %}
  <section id="watch" class="watch">
    <div class="section-head"><span class="bar" style="color:var(--ink)">📅 未来看点</span><span class="en">What to Watch</span><span class="line"></span></div>
    <ul class="watchlist">
      {% for w in watch %}
      <li class="watch-row">
        <span class="wdate">{{ w.label }}</span>
        {% if w.aid %}<a class="wtitle" href="#{{ w.aid }}">{{ w.headline }}</a>{% else %}<span class="wtitle">{{ w.headline }}</span>{% endif %}
        {% if w.tags %}<span class="wtags">{% for t in w.tags %}#{{ t }}{% if not loop.last %} {% endif %}{% endfor %}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <nav class="filters" id="filters">
    <span class="lbl">筛选</span>
    <button class="chip active" data-tag="all">全部</button>
    {% for t in tags %}<button class="chip" data-tag="{{ t }}">{{ t }}</button>{% endfor %}
  </nav>

  <!-- 全卡片宏（机构 + 人物的 high/medium 共用）。key_date/研判仅 high 显示 -->
  {% macro sigcard(it) %}
  <article class="sig {{ it.signal }}" id="{{ it._aid }}" data-tags="{{ it.tags|join(',') }}" data-pt="{{ it._ptgroup }}">
    <div class="meta-top">
      <span class="sig-lab {{ it.signal }}">{{ '高' if it.signal=='high' else '中' }}</span>
      {% if it._is_person %}<span class="stype st-person">💬观点 · {{ it._title }}</span>
      {% else %}<span class="stype st-{{ it._stype }}">{{ it._srcbadge }}</span>{% endif %}
      {% if it.rumor %}<span class="rumor">未证实</span>{% endif %}
      {% if it._is_new %}<span class="fresh">新</span>{% endif %}
      {% if it.signal=='high' and it.key_date %}<span class="kdate{% if it._date_old %} old{% endif %}">{% if it._date_old %}旧闻· {% endif %}{{ it.key_date }}</span>{% endif %}
    </div>
    <h2 class="sig-h">{% if it.url %}<a href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it._headline }}</a>{% else %}{{ it._headline }}{% endif %}</h2>
    {% if it._disp %}<p class="synopsis">{{ it._disp }}</p>{% endif %}
    {% if it.impact and not it._is_person %}<div class="impact"><b>影响</b>{{ it.impact }}</div>{% endif %}
    {% if it._is_person %}<div class="byline"><span class="lbl">观点来自</span><span class="person au">{{ it.author or it.source }}</span></div>
    {% elif it.involved %}<div class="who"><span class="who-lbl">涉及</span>{% for p in it.involved %}<span class="person">{{ p }}</span>{% endfor %}</div>{% endif %}
    {% if it.signal=='high' and it.client_soval %}<div class="soval"><span class="soval-lbl">📌 研判</span>{{ it.client_soval }}</div>{% endif %}
    <div class="card-foot">
      <span class="src">{{ it.source }} · {{ it._rel }}{% if it.url %} · <a href="{{ it.url }}" target="_blank" rel="noopener noreferrer">查看原文 ↗</a>{% endif %}</span>
      {% if it.tags %}<div class="tags">{% for t in it.tags %}<span class="tag" data-tag="{{ t }}"># {{ t }}</span>{% endfor %}</div>{% endif %}
    </div>
  </article>
  {% endmacro %}

  <!-- 瘦卡宏（人物 low）-->
  {% macro slimcard(it) %}
  <article class="pcard" data-tags="{{ it.tags|join(',') }}" data-pt="{{ it._ptgroup }}">
    <div class="prow1">
      <span class="pauthor">{{ it.author or it.source }}</span>
      <span class="ptitle">{{ it._title }}</span>
      <span class="ptag pt-{{ it._ptgroup }}">{{ it._ptlabel }}</span>
    </div>
    <a class="pone"{% if it.url %} href="{{ it.url }}" target="_blank" rel="noopener noreferrer"{% endif %}>{{ it._headline }}</a>
    <div class="prow3">
      <span class="ptime">{{ it._rel }}</span>
      {% if it.tags %}{% for t in it.tags %}<span class="tag" data-tag="{{ t }}"># {{ t }}</span>{% endfor %}{% endif %}
      <span class="plab low">低</span>
    </div>
  </article>
  {% endmacro %}

  <!-- ② 高信号（机构，展开）-->
  <section id="high">
    <div class="section-head"><span class="bar" style="color:var(--red)">🔴 高信号</span><span class="en">Top Signals · 官方/机构</span><span class="line"></span></div>
    <div class="newline">＋ {% if new_count %}自上次运行新增 {{ new_count }} 条{% else %}自上次运行无新增{% endif %}</div>
    {% if high %}{% for it in high %}{{ sigcard(it) }}{% endfor %}
    {% else %}<div class="empty-note">暂无高信号 — 平静即是好消息</div>{% endif %}
  </section>

  <!-- ③ 值得关注（机构 medium，整块收起）-->
  {% if medium %}
  <section id="medium">
    <div class="section-head"><span class="bar" style="color:var(--amber)">🟡 值得关注</span><span class="en">Worth a Look · 官方/机构</span><span class="line"></span></div>
    <details class="foldblock">
      <summary>值得关注 {{ medium|length }} 条 ›</summary>
      {% for it in medium %}{{ sigcard(it) }}{% endfor %}
    </details>
  </section>
  {% endif %}

  <!-- ④ 人在说什么（个人发言，按信号分组：高展开/中低收起）-->
  {% if people_high or people_med or people_low %}
  <section id="people">
    <div class="section-head"><span class="bar" style="color:var(--ink)">🗣 人在说什么</span><span class="en">What People Are Saying · 个人</span><span class="line"></span></div>
    <div class="psub" id="psub">
      <button class="psub-btn active" data-pt="all">全部</button>
      <button class="psub-btn" data-pt="reporter">记者</button>
      <button class="psub-btn" data-pt="scholar">学者</button>
      <button class="psub-btn" data-pt="vcind">创投/产业</button>
    </div>
    {% if people_high %}
      <div class="pgroup-lbl">高信号 · {{ people_high|length }} 条</div>
      {% for it in people_high %}{{ sigcard(it) }}{% endfor %}
    {% endif %}
    {% if people_med %}
      <details class="pgroup">
        <summary>中信号 {{ people_med|length }} 条 ›</summary>
        {% for it in people_med %}{{ sigcard(it) }}{% endfor %}
      </details>
    {% endif %}
    {% if people_low %}
      <details class="pgroup">
        <summary>低信号 {{ people_low|length }} 条 ›</summary>
        {% for it in people_low %}{{ slimcard(it) }}{% endfor %}
      </details>
    {% endif %}
  </section>
  {% endif %}

  <!-- ⑤ 低信号（机构，折叠）-->
  {% if low %}
  <section id="low">
    <details class="low">
      <summary>⚪ 低信号(机构) · {{ low|length }} 条（多为转述、旧闻或与中美经贸无关）</summary>
      {% for it in low %}
      <div class="low-item" data-tags="{{ it.tags|join(',') }}">
        <span class="src">{{ it.source }} ·</span>
        <span class="lt">{% if it.url %}<a href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it._headline }}</a>{% else %}{{ it._headline }}{% endif %}{% if it._disp %} — {{ it._disp }}{% endif %}{% if it._is_new %} <span class="fresh">新</span>{% endif %}</span>
        {% if it.tags %}<span class="ltag">{{ it.tags|join(' · ') }}</span>{% endif %}
      </div>
      {% endfor %}
    </details>
  </section>
  {% endif %}

  <footer>
    china-policy-radar · 官方 + 智库/Substack + 人物(X/Bluesky) · headline/摘要/影响/今日主线由 Claude 打分时生成，仅基于各条已有信息 · 数据直接渲染、无任何浏览器本地存储
  </footer>
</div>

<script>
(function(){
  var active = new Set(), activePt = 'all';
  var allChip = document.querySelector('.chip[data-tag="all"]');
  var tagChips = Array.prototype.slice.call(document.querySelectorAll('.chip[data-tag]')).filter(function(c){return c.dataset.tag!=='all';});
  var cards = Array.prototype.slice.call(document.querySelectorAll('[data-tags]'));
  var psubBtns = Array.prototype.slice.call(document.querySelectorAll('.psub-btn'));
  var pgroups = Array.prototype.slice.call(document.querySelectorAll('details.pgroup'));
  var foldblocks = Array.prototype.slice.call(document.querySelectorAll('details.foldblock, details.low'));

  function sync(){
    tagChips.forEach(function(c){ c.classList.toggle('active', active.has(c.dataset.tag)); });
    allChip.classList.toggle('active', active.size===0);
    psubBtns.forEach(function(b){ b.classList.toggle('active', b.dataset.pt===activePt); });
  }
  function apply(){
    cards.forEach(function(card){
      var tags = (card.getAttribute('data-tags')||'').split(',').filter(Boolean);
      var tagOk = active.size===0 || tags.some(function(t){ return active.has(t); });
      var pt = card.getAttribute('data-pt');
      var ptOk = !pt || activePt==='all' || pt===activePt;
      card.classList.toggle('hide', !(tagOk && ptOk));
    });
    // 有筛选时自动展开折叠块，避免命中项藏在折叠里
    if(active.size>0){ foldblocks.forEach(function(d){ d.open=true; }); }
    pgroups.forEach(function(d){ if(active.size>0 || activePt!=='all') d.open=true; });
  }
  function toggleTag(t){
    if(t==='all'){ active.clear(); } else if(active.has(t)){ active.delete(t); } else { active.add(t); }
    sync(); apply();
  }
  document.querySelectorAll('[data-tag]').forEach(function(el){
    if(el.tagName==='A') return;
    el.addEventListener('click', function(ev){ ev.preventDefault(); toggleTag(el.dataset.tag); });
  });
  psubBtns.forEach(function(b){ b.addEventListener('click', function(){ activePt=b.dataset.pt; sync(); apply(); }); });

  // 锚点导航：跳到某板块时展开其内全部折叠区（纯交互，无存储）
  document.querySelectorAll('.anchornav a[data-open]').forEach(function(a){
    a.addEventListener('click', function(){
      var sec = document.getElementById(a.dataset.open);
      if(sec) sec.querySelectorAll('details').forEach(function(d){ d.open = true; });
    });
  });
})();
</script>
</body>
</html>
